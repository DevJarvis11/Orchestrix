{
	"name": "@orchestrix/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome format --write .",
		"preview": "vite preview",
		"gen:openapi": "cd ../.. && uv run python apps/web/scripts/export_openapi.py",
		"gen:api": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
		"test": "vitest run"
	},
	"dependencies": {
		"@hookform/resolvers": "^7.0.3",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@tanstack/react-query": "^5.106.1",
		"@tanstack/react-router": "^1.170.46",
		"@xyflow/react": "^12.12.1",
		"clsx": "^2.1.1",
		"elkjs": "^0.12.1",
		"lucide-react": "^1.70.0",
		"oidc-client-ts": "^3.5.0",
		"openapi-fetch": "^0.17.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-hook-form": "^7.91.0",
		"react-markdown": "^10.1.0",
		"recharts": "^3.10.1",
		"rehype-sanitize": "^6.0.0",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^31.0.0",
		"openapi-typescript": "^7.13.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.1.0"
	}
}
