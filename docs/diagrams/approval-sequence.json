  "cards": [
    {
      "dot": "rose",
      "title": "Before, never after",
      "items": [
        "The interrupt happens before the tool runs, so approval can never follow its own side effect",
        "A requester can never approve their own task (four-eyes rule in OPA)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Safe to repeat",
      "items": [
        "Escalation rows upsert by interrupt id; tool calls are keyed by run, checkpoint and call id",
        "A resumed or crashed run returns the stored tool result instead of sending twice"
      ]
    }
