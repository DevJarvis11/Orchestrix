    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "The API writes the task, enqueues the run, and streams events over SSE",
        "Any worker can resume any run from its Postgres checkpoint"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety",
      "items": [
        "OPA checks every tool call; sensitive tools pause for human approval",
        "The sandbox has no network and no storage credentials"
      ]
    },
    {
      "dot": "emerald",
      "title": "Model-agnostic",
      "items": [
        "Agents ask for a role; ORCHESTRIX_DEFAULT_MODELS maps it to a catalogue model",
        "Ollama fallback is off when ORCHESTRIX_LOCAL_FALLBACK=false"
      ]
    },
    {
      "dot": "amber",
