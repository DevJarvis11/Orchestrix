    {
      "dot": "emerald",
      "title": "Returns not drawn",
      "items": [
        "Clarify answers go back to Plan",
        "An approved subtask returns to Dispatch, which starts the next ready ones",
        "Escalation decisions resume the subtask: approve, take over, retry or skip"
      ]
    },
    {
      "dot": "rose",
      "title": "Gates",
      "items": [
        "Plan gate: low confidence, approval flag, or a plan invalid twice",
        "Escalate: a subtask failed twice or scored low after 2 revisions",
        "Sensitive tools and budget_100 also pause inside a specialist"
      ]
    },
    {
      "dot": "amber",
      "title": "Stops",
      "items": [
