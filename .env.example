# Orchestrix local environment. `make env` (scripts/gen-env.sh) copies this to .env and replaces
# every __GENERATE__ with a random secret. .env is gitignored; never commit real values.

# --- Postgres (infra/compose/postgres/initdb creates the roles from these) ---
POSTGRES_PASSWORD=__GENERATE__
ORCHESTRIX_APP_PASSWORD=__GENERATE__
ORCHESTRIX_MIGRATOR_PASSWORD=__GENERATE__
ORCHESTRIX_READONLY_PASSWORD=__GENERATE__
LITELLM_DB_PASSWORD=__GENERATE__

# --- Object storage ---
S3_ROOT_USER=orchestrix
S3_ROOT_PASSWORD=__GENERATE__

# --- Model gateway (SPEC 16, amendment A1) ---
LITELLM_MASTER_KEY=sk-__GENERATE__
# Yotta gateway over VPN. Paste the key from README-gpt-oss-120b.md here; it stays in .env only.
REMOTE_LLM_BASE_URL=http://172.18.220.50:4000
REMOTE_LLM_API_KEY=
# The WSL Ollama as seen from containers. The Makefile sets this from the WSL IP on every run,
# because host.docker.internal is the Windows host (a different Ollama). Fallback value only.
OLLAMA_BASE_URL=http://localhost:11434

# --- Service-to-service ---
ORCHESTRIX_MCP_SERVICE_TOKEN=__GENERATE__

# --- App settings for host-side commands (make migrate/gateway-check, pytest).
# Compose services get container-network URLs from docker-compose.yml instead. ---
ORCHESTRIX_ENV=development
ORCHESTRIX_AUTH_MODE=dev
ORCHESTRIX_DATABASE_URL=postgresql+psycopg://orchestrix_app:${ORCHESTRIX_APP_PASSWORD}@localhost:55432/orchestrix
ORCHESTRIX_MIGRATOR_DATABASE_URL=postgresql+psycopg://orchestrix_migrator:${ORCHESTRIX_MIGRATOR_PASSWORD}@localhost:55432/orchestrix
ORCHESTRIX_REDIS_URL=redis://localhost:56379/0
ORCHESTRIX_S3_ENDPOINT=http://localhost:59000
ORCHESTRIX_S3_ACCESS_KEY=${S3_ROOT_USER}
ORCHESTRIX_S3_SECRET_KEY=${S3_ROOT_PASSWORD}
ORCHESTRIX_LITELLM_URL=http://localhost:54000
ORCHESTRIX_LITELLM_MASTER_KEY=${LITELLM_MASTER_KEY}
ORCHESTRIX_OPA_URL=http://localhost:58181
ORCHESTRIX_SEARXNG_URL=http://localhost:58888
